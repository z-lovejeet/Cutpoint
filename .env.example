# ==============================================================================
# Cutpoint Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Application Environments
ENVIRONMENT="development"
PORT=8000
NEXT_PUBLIC_API_URL="http://localhost:8000"
BACKEND_CORS_ORIGINS="http://localhost:3000,https://cutpoint.app"

# ------------------------------------------------------------------------------
# Supabase Configuration (Authentication & Database)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# Google Cloud & YouTube API Credentials
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback"
YOUTUBE_API_KEY="your-youtube-data-api-v3-key"

# ------------------------------------------------------------------------------
# Multimodal AI: Google Gemini (Video Analysis)
# ------------------------------------------------------------------------------
# Option A: Google AI Studio (Recommended for development)
GEMINI_API_KEY="your-google-ai-studio-gemini-api-key"

# Option B: Google Cloud Vertex AI (Optional for enterprise scaling)
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
# GOOGLE_CLOUD_PROJECT="cutpoint-dev"
# GOOGLE_CLOUD_LOCATION="us-central1"

# ------------------------------------------------------------------------------
# Fast LLM Inference: Groq API (Reports & Chat Agent)
# ------------------------------------------------------------------------------
GROQ_API_KEY="your-groq-api-key"
GROQ_REPORT_MODEL="openai/gpt-oss-20b"
GROQ_CHAT_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="groq/compound-mini"

# ------------------------------------------------------------------------------
# Security & Session Secrets
# ------------------------------------------------------------------------------
SECRET_KEY="generate-a-secure-random-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
